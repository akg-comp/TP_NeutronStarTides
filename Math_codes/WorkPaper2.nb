 RowBox[{
  RowBox[{"(*", "Christoffel", "*)"}], "\n", 
  RowBox[{
   RowBox[{"\[CapitalGamma]", " ", "=", " ", "\n", "  ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"BISERIES", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"1", "/", "2"}], " ", 
                RowBox[{"gUU", "[", 
                 RowBox[{"[", 
                  RowBox[{"a", ",", "l"}], "]"}], "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"gdd", "[", 
                    RowBox[{"[", 
                    RowBox[{"l", ",", " ", "b"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", "c", "]"}], "]"}]}], "]"}], " ", "+", " ", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"gdd", "[", 
                    RowBox[{"[", 
                    RowBox[{"l", ",", " ", "c"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "-", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"gdd", "[", 
                    RowBox[{"[", 
                    RowBox[{"c", ",", " ", "b"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", 
               " ", 
               RowBox[{"{", 
                RowBox[{"l", ",", " ", "1", ",", " ", "dim"}], "}"}]}], "]"}],
              ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "0", ",", "ORDER"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[Epsilon]", ",", " ", "0", ",", "ORDER"}], "}"}]}], 
          "]"}], "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "1", ",", "dim"}], "}"}], ",", " ", 
